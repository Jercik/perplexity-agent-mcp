#!/usr/bin/env bash
# Native Git hook - enable with: git config core.hooksPath .githooks
set -euo pipefail

bash scripts/check-msg.sh < "$1"

ignored_staged_paths=(
  ":(exclude).claude/**"
  ":(exclude).clawpatch/**"
  ":(exclude).codex/**"
  ":(exclude).agents/rules/**"
  ":(exclude).agents/*.md"
  ":(exclude).agents/**/*.md"
)

has_staged_changes() {
  if [[ "$#" -eq 0 ]]; then
    git diff --cached --quiet -- . "${ignored_staged_paths[@]}" || return 0
    return 1
  fi

  git diff --cached --quiet -- "$@" || return 0
  return 1
}

if ! git cat-file -e :package.json 2>/dev/null; then
  exit 0
fi

if ! has_staged_changes; then
  exit 0
fi

if ! command -v pnpm >/dev/null 2>&1; then
  printf '%s\n' 'pnpm is required to run commit-msg checks.' >&2
  exit 127
fi

temporary_directory=$(cd "${TMPDIR:-/tmp}" && pwd -P)
export TMPDIR="$temporary_directory"
script_log=""
cancel_signals=(HUP INT QUIT TERM)

stop_checks() {
  local process_group
  for process_group in $(jobs -p); do
    kill -KILL -- "-$process_group" 2>/dev/null || true
  done
  wait 2>/dev/null || true
}

cancel_checks() {
  trap '' "${cancel_signals[@]}"
  stop_checks
  if [[ -n $script_log ]]; then
    cat "$script_log" >&2
  fi
  exit "$1"
}
for cancel_signal in "${cancel_signals[@]}"; do
  cancel_exit_status=$((128 + $(kill -l "$cancel_signal")))
  trap "cancel_checks $cancel_exit_status" "$cancel_signal"
done

# The watcher reads one message per line: a PID is the process group of the running check, `-`
# says no check is running, and `cleaned` says cleanup finished. A subshell takes the SIGPIPE
# when the snapshot watcher is gone, so the hook carries on.
tell_watcher() {
  (printf '%s\n' "$1" >&6) 2>/dev/null || true
}

run_step() {
  local label="$1"
  shift
  echo "==> $label" >&2
  # A separate process group lets cancellation stop the check and its children.
  set -m
  "$@" > "$script_log" 2>&1 6>&- &
  local step_pid=$!
  set +m
  tell_watcher "$step_pid"
  if wait "$step_pid"; then
    tell_watcher -
    return 0
  fi
  tell_watcher -
  cat "$script_log" >&2
  return 1
}

run_script() {
  run_step "$1" pnpm run "$1"
}

manifests_staged=false
if has_staged_changes package.json pnpm-lock.yaml pnpm-workspace.yaml; then
  manifests_staged=true
fi

# The declaration check runs only when a commit stages one of the inputs that
# dts_inputs_staged tests below, to keep source-only commits fast. A
# source-only commit that first imports an already-declared package with leaky
# typings therefore passes here, and CI catches it. Decided before the snapshot
# worktree is entered, where nothing is staged.
dts_inputs_staged=false
if has_staged_changes ':(glob)**/package.json' pnpm-lock.yaml pnpm-workspace.yaml ':(glob)**/tsconfig*.json'; then
  dts_inputs_staged=true
fi

snapshot_tree=$(git write-tree)
if ! git cat-file -e "$snapshot_tree:pnpm-lock.yaml" 2>/dev/null; then
  printf '%s\n' 'commit-msg checks install from the staged pnpm-lock.yaml; stage it to commit.' >&2
  exit 1
fi
snapshot_parent=()
if git rev-parse --quiet --verify HEAD >/dev/null; then
  snapshot_parent=(-p HEAD)
fi
snapshot_commit=$(git commit-tree "${snapshot_parent[@]+"${snapshot_parent[@]}"}" -m "pre-commit snapshot" "$snapshot_tree")
git_common_dir=$(git rev-parse --path-format=absolute --git-common-dir)

pnpm_store_dir=$(pnpm store path)
# Prefer the store the working tree linked from while it exists here at the same store version.
if [[ -f node_modules/.modules.yaml ]]; then
  installed_store_dir=$(node -e 'try { const { storeDir } = JSON.parse(require("fs").readFileSync("node_modules/.modules.yaml", "utf8")); if (typeof storeDir === "string") process.stdout.write(storeDir) } catch {}')
  if [[ -n "$installed_store_dir" && "${installed_store_dir##*/}" == "${pnpm_store_dir##*/}" && -d "$installed_store_dir/files" ]]; then
    pnpm_store_dir=$installed_store_dir
  fi
fi

# Checks resolve git from the snapshot; like git entering a submodule, they keep `git -c` settings.
for git_local_env_var in $(git rev-parse --local-env-vars); do
  case "$git_local_env_var" in
    GIT_CONFIG_PARAMETERS | GIT_CONFIG_COUNT) ;;
    *) unset "$git_local_env_var" ;;
  esac
done

unregister_store_project() {
  if [[ -d "$pnpm_store_dir/projects" ]]; then
    find "$pnpm_store_dir/projects" -maxdepth 1 -type l -lname "*/${1##*/}" -delete
  fi
}

# A manual cleanup matches a retained snapshot to its log and config file by this tag.
allocation_tag="$(uname -n).$$"
snapshot_dir=""
install_git_config=""
# The watcher runs this on the values it inherited when it forked, so assign every path used here
# before starting it. A path still empty was never allocated.
remove_snapshot_files() {
  if [[ -n $script_log ]]; then
    rm -f "$script_log"
  fi
  if [[ -n $install_git_config ]]; then
    rm -f "$install_git_config"
  fi
  cd /
  if [[ -z $snapshot_dir ]]; then
    return 0
  fi
  # A second --force also removes the worktree an interrupted `git worktree add` left locked.
  if ! git --git-dir="$git_common_dir" worktree remove --force --force "$snapshot_dir" 2>/dev/null; then
    chmod -R u+w "$snapshot_dir" 2>/dev/null || true
    rm -rf "${snapshot_dir:?}" || printf 'commit-msg: could not remove %s\n' "$snapshot_dir" >&2
    # A kill during `git worktree remove` can delete the .git file first; once the directory is gone, git drops the registration.
    git --git-dir="$git_common_dir" worktree remove --force --force "$snapshot_dir" 2>/dev/null || true
  fi
  unregister_store_project "$snapshot_dir" || printf 'commit-msg: could not unregister %s from the pnpm store\n' "$snapshot_dir" >&2
}
remove_snapshot() {
  local status=$?
  trap '' "${cancel_signals[@]}"
  stop_checks
  remove_snapshot_files
  tell_watcher cleaned
  exit "$status"
}
# Cleans up when the hook dies without doing so itself, even by SIGKILL. The watcher runs in
# its own process group, so a kill aimed at the hook's group misses it, and it reads a pipe that
# closes once the hook and its remaining fd-6 holders exit.
watch_snapshot() {
  local message process_group=""
  trap '' PIPE "${cancel_signals[@]}"
  cd /
  while IFS= read -r message; do
    case "$message" in
      cleaned) exit 0 ;;
      -) process_group="" ;;
      *) process_group=$message ;;
    esac
  done
  if [[ -n "$process_group" ]]; then
    kill -KILL -- "-$process_group" 2>/dev/null || true
  fi
  remove_snapshot_files
}
# Installed before the allocations, so a failing one still removes the earlier ones.
trap remove_snapshot EXIT
snapshot_dir=$(mktemp -d "$temporary_directory/pre-commit-snapshot.$allocation_tag.XXXXXX")
script_log=$(mktemp "$temporary_directory/pre-commit-log.$allocation_tag.XXXXXX")
install_git_config=$(mktemp "$git_common_dir/pre-commit-install-config.$allocation_tag.XXXXXX")
# Job control gives the watcher its own process group; its standard input is the pipe. The watcher
# sees EOF only once every holder of fd 6 has exited, so close it (`6>&-`) on any command that can
# leave a process behind, such as a check or a smudge filter's daemon.
exec 6> >(set -m; watch_snapshot <&0 > /dev/null &)
# Relative worktree paths would upgrade the repository format; post-checkout hooks must not run here.
run_step "snapshot checkout" git --git-dir="$git_common_dir" -c worktree.useRelativePaths=false -c core.hooksPath=/dev/null worktree add --quiet --detach "$snapshot_dir" "$snapshot_commit"
cd "$snapshot_dir"

snapshot_git_dir=$(git rev-parse --absolute-git-dir)
config_entries="$snapshot_git_dir/install-config-entries"
config_fragment="$snapshot_git_dir/install-config-fragment"
# Resolve includes before isolating config writes; explicit config files do not follow includes by default.
git config --null --list --includes > "$config_entries"
while IFS= read -r -d '' config_entry; do
  config_key=${config_entry%%$'\n'*}
  case "$config_key" in
    include.path | includeif.*.path) continue ;;
  esac
  if [[ "$config_entry" == *$'\n'* ]]; then
    config_value=${config_entry#*$'\n'}
    git config --file "$install_git_config" --add "$config_key" "$config_value"
  else
    git config --file "$config_fragment" --add "$config_key" ""
    sed 's/ = $//' "$config_fragment" >> "$install_git_config"
    rm -f "$config_fragment"
  fi
done < "$config_entries"
# Prepare hooks may write Git config; isolate their default target during installation only.
run_step "install" env GIT_CONFIG="$install_git_config" pnpm install --store-dir "$pnpm_store_dir" --prefer-offline --frozen-lockfile --reporter=append-only
if [[ "$manifests_staged" == true ]]; then
  run_step "dedupe --check" pnpm dedupe --check --store-dir "$pnpm_store_dir" --config.confirm-modules-purge=false
fi

static_failed=0
run_script "format:check" || static_failed=1
run_script "knip" || static_failed=1
run_script "typecheck" || static_failed=1
if [[ "$dts_inputs_staged" == true ]]; then
  run_script "check:dts" || static_failed=1
fi
run_script "lint" || static_failed=1
run_script "fta" || static_failed=1
if [[ "$static_failed" -ne 0 ]]; then
  printf '%s\n' 'Static checks failed; tests were not started.' >&2
  exit 1
fi
run_script "test"
