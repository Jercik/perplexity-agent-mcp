#!/usr/bin/env bash
# Native Git hook - enable with: git config core.hooksPath .githooks
set -euo pipefail

if [[ ! -e node_modules/.bin/conventional-commit-msg ]]; then
  printf '%s\n' 'conventional-commit-msg is not installed; run `pnpm install` (it must be a devDependency).' >&2
  exit 127
fi

# The bin directly: starting pnpm to run the commit-msg script costs more than the check itself, and pnpm 11+ reinstalls first when package.json has drifted from the lockfile. The root commit-msg script exists so knip sees the bin.
exec node_modules/.bin/conventional-commit-msg "$1"
