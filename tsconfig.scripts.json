{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2025", "ESNext.Array", "ESNext.Error"],
    "noEmit": true,
    "types": ["node"],
    "composite": true
  },
  "include": ["scripts/**/*.ts", "scripts/**/*.mts", "scripts/**/*.cts"],
  "exclude": ["node_modules", "dist"]
}
